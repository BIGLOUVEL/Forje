{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": { "maxLambdaSize": "50mb" }
    },
    { "src": "*.html",        "use": "@vercel/static" },
    { "src": "*.{jsx,css}",   "use": "@vercel/static" },
    { "src": "assets/**",     "use": "@vercel/static" },
    { "src": "client/**",     "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)",    "dest": "server.js" },
    { "src": "/fonts/(.*)",  "dest": "server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)",        "dest": "index.html" }
  ]
}
